#!/usr/bin/env python3
# Writes .github/workflows/elide-ci-matrix.yml: upstream's ci-matrix-gen.yml with the jobs moved to
# Elide's runners. Upstream's file names GitHub's hosted runners and stays as it is.
#
#   ci-matrix-sync           write the file
#   ci-matrix-sync --check   fail when the file is not what this script would write
#
# Run it after a merge from upstream that changed ci-matrix-gen.yml, and commit the result.
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
WORKFLOWS = os.path.join(os.path.dirname(HERE), "workflows")
SOURCE = os.path.join(WORKFLOWS, "ci-matrix-gen.yml")
TARGET = os.path.join(WORKFLOWS, "elide-ci-matrix.yml")

RUNNER = "${{ vars.ELIDE_CI_RUNNER || 'linux-amd64-cipool' }}"
HEADER = """\
# Generated by .github/elide/ci-matrix-sync from ci-matrix-gen.yml. Do not edit: change the script
# and run it again. See .github/elide/README.md.
name: Elide CI matrix
"""
# Elide's runners keep their workspace between jobs, and the steps clone mx next to the checkout.
CLEAN = """\
      - name: Clean workspace
        shell: bash
        run: find "${GITHUB_WORKSPACE:?}" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
"""
# The runners are on a newer Ubuntu than GitHub's, for which actions/setup-python has no build of
# the exact Python versions that upstream asks for. Ask for the newest patch release instead.
EXTRACT = "          python3 .github/scripts/extract_matrix.py ./sjsonnet ./ci.jsonnet ${TARGET} ${JOBS} --artifact-mode non-providers > matrix.json\n"
ANY_PATCH = """\
          for f in artifact-matrix.json matrix.json; do
            jq -c 'map(if .python_version then .python_version |= (split(".")[0:2] | join(".")) else . end)' "$f" > "$f.tmp"
            mv "$f.tmp" "$f"
          done
"""
# line of upstream's file -> (replacement, how often upstream's file must have it)
EDITS = {
    "name: Generate CI Matrix from ci.jsonnet\n": (HEADER, 1),
    "    runs-on: ubuntu-latest\n": ("    runs-on: %s\n" % RUNNER, 3),
    "    runs-on: ${{ matrix.os }}\n": ("    runs-on: %s\n" % RUNNER, 6),
    "    steps: &generate_matrix\n": ("    steps: &generate_matrix\n" + CLEAN, 1),
    "    steps: &buildsteps\n": ("    steps: &buildsteps\n" + CLEAN, 1),
    EXTRACT: (EXTRACT + ANY_PATCH, 1),
}


def generate():
    with open(SOURCE) as f:
        lines = f.readlines()
    for line, (_, expected) in EDITS.items():
        found = lines.count(line)
        if found != expected:
            sys.exit("ci-matrix-gen.yml has %d lines %r, expected %d: upstream changed its layout, "
                     "update .github/elide/ci-matrix-sync" % (found, line.strip(), expected))
    if sum("runs-on:" in line for line in lines) != 9:
        sys.exit("ci-matrix-gen.yml has a runs-on line that .github/elide/ci-matrix-sync does not know")
    return "".join(EDITS[line][0] if line in EDITS else line for line in lines)


def main(args):
    text = generate()
    if args == ["--check"]:
        with open(TARGET) as f:
            if f.read() != text:
                sys.exit("elide-ci-matrix.yml is out of date: run python3 .github/elide/ci-matrix-sync "
                         "and commit the result")
    elif not args:
        with open(TARGET, "w") as f:
            f.write(text)
    else:
        sys.exit("usage: ci-matrix-sync [--check]")


if __name__ == "__main__":
    main(sys.argv[1:])
